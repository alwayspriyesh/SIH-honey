<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Base security: Block cleartext traffic by default in production (HTTPS required) -->
    <base-config cleartextTrafficPermitted="false" />
    <!-- Development exception: Allow cleartext HTTP strictly for local testing on LAN IP / localhost -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">10.40.114.47</domain>
    </domain-config>
</network-security-config>
